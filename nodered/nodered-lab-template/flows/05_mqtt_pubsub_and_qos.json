    {
        "id": "inj-22-sc",
        "type": "inject",
        "z": "tab-mqtt-05",
        "name": "Simulate Sensor.Community",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 180,
        "y": 390,
        "wires": [["fn-22-sc-build"]]
    },
    {
        "id": "fn-22-sc-build",
        "type": "function",
        "z": "tab-mqtt-05",
        "name": "Build Sensor.Community Object",
        "func": "msg.topic = \"/smartcity/milan\";\nmsg.payload = {\n    id: 10372898440,\n    timestamp: new Date().toISOString(),\n    sensordatavalues: [\n        { id: 22999226740, value_type: \"temperature\", value: \"16.90\" },\n        { id: 22999226768, value_type: \"humidity\", value: \"99.90\" }\n    ],\n    sensor: { id: 21666, pin: \"7\", sensor_type: { id: 9, name: \"DHT22\" } },\n    location: { latitude: \"45.486\", longitude: \"9.19\", country: \"IT\" }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 390,
        "wires": [["mqtt-out-22-sc"]]
    },
    {
        "id": "mqtt-out-22-sc",
        "type": "mqtt out",
        "z": "tab-mqtt-05",
        "name": "Publish /smartcity/milan (QoS 1)",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt-broker-local",
        "x": 760,
        "y": 390,
        "wires": []
    },
    {
        "id": "mqtt-in-22-sc",
        "type": "mqtt in",
        "z": "tab-mqtt-05",
        "name": "Subscribe /smartcity/+ (Parsed JSON)",
        "topic": "/smartcity/+",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker-local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 460,
        "wires": [["fn-22-sc-parse", "dbg-22-sc-full"]]
    },
    {
        "id": "fn-22-sc-parse",
        "type": "function",
        "z": "tab-mqtt-05",
        "name": "Extract Temperature",
        "func": "const values = msg.payload.sensordatavalues || [];\nconst tempEntry = values.find(v => v.value_type === \"temperature\");\nif (!tempEntry) {\n    return null;\n}\nreturn {\n    topic: msg.topic,\n    payload: parseFloat(tempEntry.value),\n    _msgid: msg._msgid\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 460,
        "wires": [["dbg-22-sc-temp"]]
    },
