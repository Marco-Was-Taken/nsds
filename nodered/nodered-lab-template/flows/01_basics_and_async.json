[
    {
        "id": "tab-basics-01",
        "type": "tab",
        "label": "1.1 Basics & Async",
        "disabled": false,
        "info": "Lecture 1.1: Node-RED Basics - Inject, Debug, Switch routing, and Asynchronous non-deterministic execution."
    },
    {
        "id": "comment-11-a",
        "type": "comment",
        "z": "tab-basics-01",
        "name": "Example 1: Timestamp Inject -> Debug",
        "info": "Click the inject button (or enable repeat every 1s) to generate a timestamp message.",
        "x": 200,
        "y": 60,
        "wires": []
    },
    {
        "id": "inj-11-ts",
        "type": "inject",
        "z": "tab-basics-01",
        "name": "Generate Timestamp",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "clock",
        "payload": "",
        "payloadType": "date",
        "x": 160,
        "y": 120,
        "wires": [["dbg-11-ts"]]
    },
    {
        "id": "dbg-11-ts",
        "type": "debug",
        "z": "tab-basics-01",
        "name": "Print Out Timestamp",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 440,
        "y": 120,
        "wires": []
    },
    {
        "id": "comment-11-b",
        "type": "comment",
        "z": "tab-basics-01",
        "name": "Example 2: Switch Routing (Temperature > 15C?)",
        "info": "Splits the flow based on msg.payload numeric value.",
        "x": 230,
        "y": 200,
        "wires": []
    },
    {
        "id": "inj-11-warm",
        "type": "inject",
        "z": "tab-basics-01",
        "name": "Temp = 22.1",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temp",
        "payload": "22.1",
        "payloadType": "num",
        "x": 130,
        "y": 260,
        "wires": [["sw-11-temp"]]
    },
    {
        "id": "inj-11-cold",
        "type": "inject",
        "z": "tab-basics-01",
        "name": "Temp = 12.5",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temp",
        "payload": "12.5",
        "payloadType": "num",
        "x": 130,
        "y": 320,
        "wires": [["sw-11-temp"]]
    },
    {
        "id": "sw-11-temp",
        "type": "switch",
        "z": "tab-basics-01",
        "name": "Temperature > 15C?",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            { "t": "gt", "v": "15", "vt": "num" },
            { "t": "else" }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 360,
        "y": 290,
        "wires": [["fn-11-on"], ["fn-11-off"]]
    },
    {
        "id": "fn-11-on",
        "type": "function",
        "z": "tab-basics-01",
        "name": "Turn On Conditioning",
        "func": "msg.payload = \"AC ON (temp=\" + msg.payload + \")\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 260,
        "wires": [["dbg-11-ac"]]
    },
    {
        "id": "fn-11-off",
        "type": "function",
        "z": "tab-basics-01",
        "name": "Turn Off Conditioning",
        "func": "msg.payload = \"AC OFF (temp=\" + msg.payload + \")\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 320,
        "wires": [["dbg-11-ac"]]
    },
    {
        "id": "dbg-11-ac",
        "type": "debug",
        "z": "tab-basics-01",
        "name": "AC Action",
        "active": true,
        "tosidebar": true,
        "console": false,
