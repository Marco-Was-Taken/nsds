    {
        "id": "fn-12-override",
        "type": "function",
        "z": "tab-func-02",
        "name": "Override Payload",
        "func": "let newMsg = {\n    topic: msg.topic,\n    payload: \"New message!\",\n    _msgid: msg._msgid\n};\nreturn newMsg;",
