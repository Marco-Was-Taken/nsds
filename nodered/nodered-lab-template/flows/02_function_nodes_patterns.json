    {
        "id": "fn-12-multiout",
        "type": "function",
        "z": "tab-func-02",
        "name": "Route by Priority (3 Outputs)",
        "func": "if (msg.payload === \"high\") {\n    return [msg, null, null];\n} else if (msg.payload === \"med\") {\n    return [null, msg, null];\n} else {\n    return [null, null, msg];\n}",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
