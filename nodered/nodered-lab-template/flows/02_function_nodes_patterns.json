    {
        "id": "fn-12-seq",
        "type": "function",
        "z": "tab-func-02",
        "name": "Emit 10 Messages",
        "func": "let msgList = [];\nfor (let i = 0; i < 10; i++) {\n    msgList.push({ payload: i });\n}\n// Wrapped in [msgList] so all 10 messages are sent sequentially on output 1\nreturn [msgList];",
