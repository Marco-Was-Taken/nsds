        "id": "fn-13-flow-read",
        "type": "function",
        "z": "tab-share-03",
        "name": "Read Flow & Global",
        "func": "msg.payload = {\n    flowTotal: flow.get(\"runningTotal\") || 0,\n    persistentHits: global.get(\"persistentCounter\", \"file\") || 0\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
