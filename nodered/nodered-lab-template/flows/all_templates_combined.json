    {
        "id": "fn-12-even",
        "type": "function",
        "z": "tab-func-02",
        "name": "Tell Me If Payload is Even",
        "func": "const ts = msg.payload;\nif (ts % 2 === 0) {\n    msg.payload = \"Time is even (\" + ts + \")\";\n} else {\n    msg.payload = \"Time is odd (\" + ts + \")\";\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Runs once when the flow is deployed\nnode.status({ fill: \"green\", shape: \"dot\", text: \"ready\" });",
        "finalize": "// Runs when the flow stops or re-deploys\nnode.status({});",
        "libs": [],
