        "type": "function",
        "z": "tab-mqtt-05",
        "name": "Extract Temperature",
        "func": "const values = msg.payload.sensordatavalues || [];\nconst tempEntry = values.find(v => v.value_type === \"temperature\");\nif (!tempEntry) {\n    return null;\n}\nreturn {\n    topic: msg.topic,\n    payload: parseFloat(tempEntry.value),\n    _msgid: msg._msgid\n};",
