        "type": "function",
        "z": "tab-share-03",
        "name": "Count (Node Context)",
        "func": "let val = context.get(\"value\");\nif (val === undefined) {\n    val = 0;\n}\nmsg.payload = val;\ncontext.set(\"value\", val + 1);\nreturn msg;",
