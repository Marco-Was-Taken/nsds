                "fn-13-flow-set"
            ]
        ]
    },
    {
        "id": "fn-13-flow-set",
        "type": "function",
        "z": "tab-share-03",
        "name": "Update Flow & Global Context",
        "func": "const prevFlow = flow.get(\"runningTotal\") || 0;\nconst nextFlow = prevFlow + msg.payload;\nflow.set(\"runningTotal\", nextFlow);\n\n// Also persist across restarts using the 'file' store from settings.js\nconst prevPersistent = global.get(\"persistentCounter\", \"file\") || 0;\nglobal.set(\"persistentCounter\", prevPersistent + 1, \"file\");\n\nmsg.payload = { flowTotal: nextFlow, persistentHits: prevPersistent + 1 };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 480,
        "wires": [
            [
                "dbg-13-flow"
            ]
        ]
    },
