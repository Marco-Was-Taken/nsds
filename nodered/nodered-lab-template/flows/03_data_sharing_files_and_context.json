        "wires": [["fn-13-inc-file"]]
    },
    {
        "id": "fn-13-inc-file",
        "type": "function",
        "z": "tab-share-03",
        "name": "Convert and Increment",
        "func": "let current = parseInt(msg.payload, 10);\nif (isNaN(current)) {\n    current = 0;\n}\nmsg.payload = current + 1;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 120,
        "wires": [["file-out-13", "dbg-13-file"]]
    },
    {
        "id": "inj-13-init-file",
        "type": "inject",
        "z": "tab-share-03",
        "name": "Initialize to 0",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "0",
        "payloadType": "num",
        "x": 130,
        "y": 200,
        "wires": [["file-out-13"]]
