    },
    {
        "id": "file-in-13",
        "type": "file in",
        "z": "tab-share-03",
        "name": "Read Counter",
        "filename": "nodered-lab-template/data/counter.txt",
        "filenameType": "str",
        "format": "utf8",
        "chunk": false,
        "sendError": false,
        "encoding": "none",
        "allProps": false,
        "x": 310,
