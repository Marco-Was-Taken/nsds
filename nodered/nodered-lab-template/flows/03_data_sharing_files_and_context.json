    {
        "id": "comment-13-b",
        "type": "comment",
        "z": "tab-share-03",
        "name": "Pattern 2: Node Context Counter (in-memory, resets on full deploy)",
        "info": "",
        "x": 270,
        "y": 280,
        "wires": []
    },
    {
        "id": "inj-13-ctx",
        "type": "inject",
        "z": "tab-share-03",
        "name": "Trigger",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 120,
        "y": 340,
        "wires": [["fn-13-ctx"]]
    },
    {
        "id": "fn-13-ctx",
        "type": "function",
        "z": "tab-share-03",
        "name": "Count (Node Context)",
        "func": "let val = context.get(\"value\");\nif (val === undefined) {\n    val = 0;\n}\nmsg.payload = val;\ncontext.set(\"value\", val + 1);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 340,
        "wires": [["dbg-13-ctx"]]
    },
    {
        "id": "dbg-13-ctx",
        "type": "debug",
        "z": "tab-share-03",
