    {
        "id": "comment-13-a",
        "type": "comment",
        "z": "tab-share-03",
        "name": "Pattern 1: File-based Counter (read -> increment -> write back)",
        "info": "At boot (once: true), initializes counter.txt to 0. Each Trigger reads, increments, writes back, and prints.",
        "x": 260,
        "y": 60,
        "wires": []
    },
    {
        "id": "inj-13-trigger-file",
        "type": "inject",
        "z": "tab-share-03",
        "name": "Trigger",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
