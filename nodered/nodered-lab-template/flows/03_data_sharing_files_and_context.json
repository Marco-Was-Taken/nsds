        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 600,
        "y": 340,
        "wires": []
    },
    {
        "id": "comment-13-c",
        "type": "comment",
        "z": "tab-share-03",
        "name": "Pattern 3: Flow Context & Persistent File Context Store",
        "info": "Uses flow.set/flow.get to share state across chains, and store 'file' (configured in settings.js) to survive restarts.",
        "x": 240,
        "y": 420,
        "wires": []
    },
    {
        "id": "inj-13-flow-set",
        "type": "inject",
        "z": "tab-share-03",
        "name": "Add +5 to Flow Total",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "5",
        "payloadType": "num",
        "x": 160,
        "y": 480,
        "wires": [["fn-13-flow-set"]]
    },
    {
        "id": "fn-13-flow-set",
        "type": "function",
        "z": "tab-share-03",
        "name": "Update Flow & Global Context",
        "func": "const prevFlow = flow.get(\"runningTotal\") || 0;\nconst nextFlow = prevFlow + msg.payload;\nflow.set(\"runningTotal\", nextFlow);\n\n// Also persist across restarts using the 'file' store from settings.js\nconst prevPersistent = global.get(\"persistentCounter\", \"file\") || 0;\nglobal.set(\"persistentCounter\", prevPersistent + 1, \"file\");\n\nmsg.payload = { flowTotal: nextFlow, persistentHits: prevPersistent + 1 };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 480,
        "wires": [["dbg-13-flow"]]
    },
    {
        "id": "inj-13-flow-read",
        "type": "inject",
        "z": "tab-share-03",
        "name": "Read Shared State",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 540,
        "wires": [["fn-13-flow-read"]]
    },
    {
        "id": "fn-13-flow-read",
        "type": "function",
        "z": "tab-share-03",
        "name": "Read Flow & Global",
        "func": "msg.payload = {\n    flowTotal: flow.get(\"runningTotal\") || 0,\n    persistentHits: global.get(\"persistentCounter\", \"file\") || 0\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
