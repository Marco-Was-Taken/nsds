    {
        "id": "fn-lab2-chat-prep",
        "type": "function",
        "z": "tab-lab2-example",
        "name": "Attach Chat Context",
        "func": "const text = String(msg.payload || \"\");\nmsg.originalMessage = {\n    chat: { id: \"lab2-demo\" },\n    transport: \"telegram\"\n};\nmsg.chat = function () {\n    return {\n        get: function () { return null; },\n        set: function () {}\n    };\n};\nmsg.payload = {\n    type: \"message\",\n    content: text,\n    chatId: \"lab2-demo\",\n    inbound: true\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 530,
        "wires": [
