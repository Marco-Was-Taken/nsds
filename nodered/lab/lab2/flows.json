        "name": "Count (file) & Save State",
        "func": "const count = (context.get(\"mqttCount\", \"file\") || 0) + 1;\ncontext.set(\"mqttCount\", count, \"file\");\nflow.set(\"lastMqttEvent\", msg.payload);\nmsg.payload = {\n    count: count,\n    topic: msg.topic,\n    event: msg.payload\n};\nreturn msg;",
