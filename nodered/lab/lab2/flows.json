    {
        "id": "fn-lab2-chat-state",
        "type": "function",
        "z": "tab-lab2-example",
        "name": "Read Flow State",
        "func": "const lastUdp = flow.get(\"lastUdpTelemetry\");\nconst lastMqtt = flow.get(\"lastMqttEvent\");\nconst udpStr = lastUdp ? `${lastUdp.temp}C` : \"N/A\";\nconst mqttStr = lastMqtt ? `${lastMqtt.temp}C` : \"N/A\";\nmsg.payload = Object.assign({}, msg.payload, {\n    summary: `UDP=${udpStr}, MQTT=${mqttStr}`\n});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 500,
        "wires": [
