    {
        "id": "f8ba0e479114c35f",
        "type": "function",
        "z": "1e27afcb11722f87",
        "name": "PollenFilter",
        "func": "let pollenValue = msg.payload.current;\n\nlet pollenUnits = msg.payload.current_units;\n\nif(pollenValue == undefined || pollenUnits == undefined || pollenValue == null || pollenUnits == null){\n    return null;\n}\n\nconst newPayload = {\n    current: pollenValue,\n    current_units: pollenUnits\n}\n\nconst newMsg = {\n    __msgid__ : msg._msgid,\n    topic: msg.topic,\n    payload : newPayload,\n\n}\n\n\nreturn newMsg;",
