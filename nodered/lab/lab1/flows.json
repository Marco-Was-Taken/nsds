    {
        "id": "9ddbd509502f5d7b",
        "type": "function",
        "z": "8e9c892fa28a5f30",
        "name": "AverageSetting",
        "func": "const newTemp = msg.payload.tempc;\nconst oldTemp = context.get(\"oldTemp\");\ncontext.set(\"oldTemp\", newTemp);\n\nlet average = newTemp;\nif (oldTemp !== undefined) {\n    average = (oldTemp + newTemp) / 2;\n}\n\nreturn {\n    _msgid: msg._msgid,\n    topic: msg.topic,\n    payload: average\n};",
